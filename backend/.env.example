# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas or Local MongoDB)
# Note: Keep real credentials in your local .env file. The .env file is git-ignored and must never be committed.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=reiki_vastu

# Security / CORS (Comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
COOKIE_SECRET=your_super_secret_cookie_key_here_min_32_characters

# Initial Admin Seeding (Used only when running node scripts/seedAdmin.js)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_this_secure_password_123
INITIAL_ADMIN_NAME=Dr. Naresh Chhabdiya

# Admin Notification Settings (Where submission alerts should be sent)
# Set to the site owner's or coordinator's real email address.
ADMIN_NOTIFICATION_EMAIL=owner@example.com

# Admin Dashboard URL (Optional: include direct link in alert emails; omit if not configured)
ADMIN_DASHBOARD_URL=http://localhost:5173

# SMTP Email Transport Settings (Optional: if omitted or left with example placeholders, submissions save normally without dispatching emails)
#
# IMPORTANT DOMAIN & PROVIDER CONSTRAINTS:
# 1. Custom domain not owned/configured:
#    Do NOT use an unverified domain in SMTP_FROM (such as "@reikivaastuworld.com") because SMTP servers
#    and inbox providers (Gmail, Outlook, Yahoo) will reject or mark unauthenticated sender identities as spam/spoofing.
# 2. Sending via a Gmail / Google Workspace account:
#    - SMTP_HOST=smtp.gmail.com
#    - SMTP_PORT=587
#    - SMTP_SECURE=false (uses STARTTLS) or 465 with SMTP_SECURE=true
#    - SMTP_USER=your_verified_address@gmail.com
#    - SMTP_PASS=<16-character Google App Password from myaccount.google.com/apppasswords - NOT your Google account password>
#    - SMTP_FROM="Reiki & Vaastu World" <your_verified_address@gmail.com> (must match the authenticated user)
# 3. Sending via Transactional Providers (Brevo / SendGrid / Postmark):
#    - Providers such as Brevo allow verifying an individual sender email address without requiring a custom domain.
#    - Once verified, set SMTP_USER and SMTP_PASS provided by that service, and set SMTP_FROM to that verified sender.
#
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="Reiki & Vaastu World" <user@example.com>
